{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-permission-system/main/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "permission": {
    "*": "deny",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.codex/auth.json": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/Library/Keychains/*": "deny"
    },
    "external_directory": "deny",
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "sed *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "mkdir *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git branch": "allow",
      "git ls-files*": "allow",
      "git grep*": "allow",
      "pytest*": "allow",
      "python -m pytest*": "allow",
      "python3 -m pytest*": "allow",
      ".venv/bin/python -m pytest*": "allow",
      "uv run pytest*": "allow",
      "npm test*": "allow",
      "npm run test*": "allow",
      "pnpm test*": "allow",
      "pnpm run test*": "allow",
      "bun test*": "allow",
      "go test*": "allow",
      "cargo test*": "allow",
      "make test*": "allow",
      "make check*": "allow",
      "make verify*": "allow",
      "rm *": "deny",
      "rmdir *": "deny",
      "mv *": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "sudo *": "deny",
      "security *": "deny",
      "defaults *": "deny",
      "launchctl *": "deny",
      "kill *": "deny",
      "pkill *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "rsync *": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git checkout*": "deny",
      "git restore*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git pull*": "deny",
      "git fetch*": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git config*": "deny",
      "git remote*": "deny",
      "git branch -d*": "deny",
      "git branch -D*": "deny",
      "npm install*": "deny",
      "pnpm install*": "deny",
      "bun install*": "deny",
      "pip install*": "deny",
      "pip3 install*": "deny",
      "uv add*": "deny",
      "brew *": "deny"
    }
  }
}
